# ---------------------------------------------------------------------------
# TokenFlow environment variables
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# Never commit a filled-in .env.local or production secret to source control.
# ---------------------------------------------------------------------------

# Supabase project URL (Supabase dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key (safe for the browser; RLS still applies)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase service role key (SERVER ONLY - bypasses RLS, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend email API key (Resend dashboard -> API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address, e.g. "TokenFlow <tickets@yourdomain.com>"
RESEND_FROM_EMAIL=TokenFlow <tickets@yourdomain.com>

# Trigger.dev project ref (Trigger.dev dashboard -> Project settings)
TRIGGER_PROJECT_ID=proj_your_project_ref

# Trigger.dev secret key (Trigger.dev dashboard -> Project -> API Keys)
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: public app URL used in emails and redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
